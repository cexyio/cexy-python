                "coin": "BTC",
                "side": "buy",
                "price": "60000.0",
                "size": "0.01",
                "direction": "Open Long",
                "closed_pnl": "0",
                "taker": true,
                "time": 1790000000100
              }
            ],
            "next_cursor": null
          }
        }
      ],
      "expect": {
        "ids": [
          "f1",
          "f2",
          "f3"
        ],
        "requests": 3,
        "sleeps": 0
      }
    },
