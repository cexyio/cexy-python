          "client": "auth",
          "token": "tok_a"
        },
        {
          "server": {
            "type": "authenticated",
            "user_id": "aaaa0001"
          },
          "reply_to": "auth"
        },
        {
          "client": "subscribe",
          "channels": [
            "orders"
          ]
        },
        {
