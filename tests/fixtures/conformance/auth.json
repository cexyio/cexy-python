{
  "description": "Auth conformance cases every SDK must pass against a mock server. There is no request signing yet; when HMAC signing lands, signing vectors are added here, generated by the exchange's own code.",
  "cases": [
    {
      "id": "key_headers_on_private",
      "request": {
        "operation": "GET /api/v1/account/balances"
      },
      "expect": {
        "headers_present": [
          "X-API-Key",
          "X-API-Secret"
        ],
        "headers_absent": [
          "Authorization"
        ]
      }
    },
    {
      "id": "no_credentials_on_public",
      "request": {
        "operation": "GET /api/v1/markets"
      },
      "expect": {
        "headers_absent": [
          "X-API-Key",
          "X-API-Secret",
          "Authorization"
        ]
      }
    },
    {
      "id": "never_in_url",
      "request": {
        "operation": "GET /api/v1/account/balances"
      },
      "expect": {
        "url_must_not_contain": [
          "ak_test_key",
          "test_secret"
        ]
      }
    },
    {
      "id": "redaction",
      "request": {
        "operation": "GET /api/v1/account/balances"
      },
      "expect": {
        "secret_not_in": [
          "client repr/str",
          "log output",
          "exception messages"
        ]
      }
    },
    {
      "id": "half_pair_rejected_locally",
      "client": {
        "api_key": "ak_test_key",
        "api_secret": null
      },
      "expect": {
        "construct_error": true,
        "requests_sent": 0
      }
    },
    {
      "id": "user_agent",
      "request": {
        "operation": "GET /api/v1/time"
      },
      "expect": {
        "header_matches": {
          "User-Agent": "^cexy-(python|typescript|go|rust)/"
        }
      }
    }
  ],
  "server_responses": [
    {
      "id": "unauthenticated",
      "status": 401,
      "body": {
        "error": {
          "code": "UNAUTHENTICATED",
          "message": "Authentication required",
          "retryable": false
        }
      },
      "expect": {
        "error_class": "AuthenticationError"
      }
    },
    {
      "id": "missing_scope",
      "status": 403,
      "body": {
        "error": {
          "code": "FORBIDDEN",
          "message": "API key lacks the trade scope",
          "retryable": false
        }
      },
      "expect": {
        "error_class": "PermissionError"
      }
    },
    {
      "id": "key_not_allowed",
      "status": 403,
      "body": {
        "error": {
          "code": "API_KEY_NOT_ALLOWED",
          "message": "This endpoint requires a session",
          "retryable": false
        }
      },
      "expect": {
        "error_class": "PermissionError"
      }
    }
  ]
}
